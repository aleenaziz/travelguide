body {
    font-family: Arial, sans-serif;
    background-color: #dfead8;
    color: #333333;
    margin: 0;
    padding: 0;
    line-height: 1.7;
}

h1 {
    background-color: #ffffff;
    color: #556b2f;
    text-align: center;
    padding: 35px 20px;
    margin: 0;
    font-size: 40px;
    letter-spacing: 1px;
}

h2 {
    color: #556b2f;
    text-align: center;
    margin: 50px 20px 25px;
    font-size: 29px;
}

h3 {
    color: #556b2f;
    text-align: center;
    font-size: 22px;
    margin-top: 35px;
}

p {
    background-color: #ffffff;
    color: #333333;
    font-size: 17px;
    max-width: 850px;
    margin: 15px auto;
    padding: 20px 25px;
    border-radius: 15px;
    box-shadow: 0 3px 12px rgba(60, 80, 50, 0.10);
}

img {
    display: block;
    max-width: 90%;
    height: auto;
    border-radius: 18px;
    margin: 20px auto;
    box-shadow: 0 4px 15px rgba(60, 80, 50, 0.15);
}

ul,
ol {
    max-width: 700px;
    margin: 25px auto;
    background-color: #ffffff;
    padding: 25px 45px;
    border-radius: 15px;
    box-shadow: 0 3px 12px rgba(60, 80, 50, 0.10);
    color: #333333;
}

li {
    margin: 10px 0;
}

strong {
    color: #556b2f;
}

body > img:first-of-type {
    width: 600px;
    max-width: 90%;
}

body > img:not(:first-of-type) {
    width: 400px;
    max-width: 90%;
}

@media (max-width: 600px) {
    h1 {
        font-size: 30px;
        padding: 25px 15px;
    }

    h2 {
        font-size: 24px;
    }

    h3 {
        font-size: 20px;
    }

    p {
        font-size: 16px;
        margin: 15px;
    }

    ul,
    ol {
        margin: 20px 15px;
        padding: 20px 35px;
    }
}